        "expect": true
      },
      {
        "op": "assert",
        "formula": "CountRows(history)=0",
        "expect": true
      },
      {
        "op": "assert",
        "formula": "LeftPulse.FormatMs(1000)=If(StartsWith(Language(),\"fr\"),\"1,0 s\",\"1.0 s\")",
        "expect": true
      },
      {
        "op": "event",
        "path": "TimerLab/LeftPulse/ActionButton",
        "event": "OnSelect"
      },
      {
        "op": "advance",
        "milliseconds": 400
      },
      {
        "op": "assert",
        "formula": "LeftPulse.Elapsed=400",
        "expect": true
      },
      {
        "op": "assert",
        "formula": "RightPulse.Elapsed=0",
        "expect": true
      },
      {
        "op": "assert",
        "formula": "LeftPulse.Starts=1",
        "expect": true
      },
      {
        "op": "event",
        "path": "TimerLab/LeftPulse/ActionButton",
        "event": "OnSelect"
      },
      {
        "op": "advance",
        "milliseconds": 600
      },
      {
        "op": "assert",
        "formula": "LeftPulse.Elapsed=400",
        "expect": true
      },
      {
        "op": "assert",
        "formula": "CountRows(history)=0",
        "expect": true
      },
      {
        "op": "event",
        "path": "TimerLab/LeftPulse/ActionButton",
        "event": "OnSelect"
      },
      {
        "op": "advance",
        "milliseconds": 600
      },
      {
        "op": "assert",
        "formula": "LeftPulse.Elapsed=0",
        "expect": true
      },
      {
        "op": "assert",
        "formula": "LeftPulse.Cycles=1",
        "expect": true
