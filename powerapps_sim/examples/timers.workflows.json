      {
        "op": "assert",
        "formula": "LeftPulse.Cycles=0",
        "expect": true
      },
      {
        "op": "assert",
        "formula": "LeftPulse.Starts=0",
        "expect": true
      },
      {
        "op": "assert",
        "formula": "CountRows(LeftPulse.History)=0",
        "expect": true
      },
      {
        "op": "assert",
        "formula": "RightPulse.Cycles=2",
        "expect": true
      },
      {
        "op": "advance",
        "milliseconds": 250
      },
      {
        "op": "assert",
        "formula": "RightPulse.Elapsed=250",
        "expect": true
      },
      {
        "op": "assert",
        "formula": "LeftPulse.Elapsed=0",
        "expect": true
      },
      {
        "op": "event",
        "path": "TimerLab/Background",
        "event": "OnSelect"
      },
      {
        "op": "advance",
        "milliseconds": 500
      },
      {
        "op": "assert",
        "formula": "BgTimer.Value=500",
        "expect": true
      },
      {
        "op": "assert",
        "formula": "FgTimer.Value=500",
        "expect": true
      },
      {
        "op": "event",
        "path": "TimerLab/ReviewButton",
        "event": "OnSelect"
      },
      {
        "op": "assert",
        "formula": "App.ActiveScreen.Name",
        "expect": "Review"
      },
      {
        "op": "advance",
        "milliseconds": 1500
      },
      {
        "op": "assert",
        "formula": "bgEnds=1",
        "expect": true
      },
      {
        "op": "assert",
        "formula": "fgEnds=0",
        "expect": true
      },
      {
        "op": "assert",
        "formula": "reviews=1",
        "expect": true
      },
      {
        "op": "assert",
        "formula": "ReviewTimer.Value=750",
        "expect": true
