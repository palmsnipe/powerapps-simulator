      },
      {
        "op": "advance",
        "milliseconds": 750
      },
      {
        "op": "assert",
        "formula": "RightPulse.Cycles=3",
        "expect": true
      },
      {
        "op": "assert",
        "formula": "FgTimer.Value=1250",
        "expect": true
      },
      {
        "op": "assert",
        "formula": "BgTimer.Value=750",
        "expect": true
      },
      {
        "op": "event",
        "path": "TimerLab/Background",
        "event": "OnSelect"
      },
      {
        "op": "advance",
        "milliseconds": 750
      },
      {
        "op": "assert",
        "formula": "FgTimer.Value=1250",
        "expect": true
      },
      {
        "op": "assert",
        "formula": "BgTimer.Value=750",
        "expect": true
      },
      {
        "op": "assert",
        "formula": "RightPulse.Elapsed=750",
        "expect": true
      },
      {
        "op": "event",
        "path": "TimerLab/BuildTable",
        "event": "OnSelect"
      },
      {
        "op": "assert",
        "formula": "CountRows(results)=8",
        "expect": true
      },
      {
        "op": "assert",
        "formula": "First(results).Nested.Right=750",
        "expect": true
      },
      {
        "op": "assert",
        "formula": "First(results).Elapsed=0",
        "expect": true
      },
      {
        "op": "event",
        "path": "TimerLab/RightPulse/ActionButton",
        "event": "OnSelect"
      },
      {
        "op": "event",
        "path": "TimerLab/LeftPulse/ActionButton",
        "event": "OnSelect"
      },
      {
        "op": "advance",
        "milliseconds": 1000
      },
      {
        "op": "assert",
        "formula": "LeftPulse.Cycles=1",
        "expect": true
      },
      {
        "op": "assert",
        "formula": "CountRows(Ticks)=4",
        "expect": true
      },
      {
        "op": "assert",
        "formula": "Last(Ticks).Cycle=1",
        "expect": true
      },
      {
        "op": "assert",
        "formula": "Last(Ticks).At",
        "expect": "2026-01-01 12:00:09"
      },
      {
        "op": "assert",
        "formula": "RightPulse.Elapsed=750",
        "expect": true
      },
      {
        "op": "diagnostics",
        "expect": 0
      }
    ]
