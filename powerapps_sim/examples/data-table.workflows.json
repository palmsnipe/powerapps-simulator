    "steps": [
      {
        "op": "assert",
        "formula": "DraftTable.Selected.ID=1 && OtherTable.Selected.ID=101",
        "expect": true
      },
      {
        "op": "event",
        "path": "TableLab/DraftTable",
        "event": "OnSelect",
        "value": {
          "column": "TableLab/DraftTable/TitleColumn"
        },
        "selection": [
          4
        ]
      },
      {
        "op": "assert",
        "formula": "DraftTable.Selected.ID=5 && DraftForm.Item.ID=5",
        "expect": true
      },
      {
        "op": "assert",
        "formula": "First(clicks).ID=5 && CountRows(clicks)=1",
        "expect": true
      },
      {
        "op": "event",
        "path": "TableLab/OtherTable",
        "event": "OnSelect",
        "selection": [
          1
        ]
      },
      {
        "op": "assert",
        "formula": "OtherTable.Selected.ID=102 && DraftTable.Selected.ID=5",
        "expect": true
      },
      {
        "op": "event",
        "path": "TableLab/DraftForm/TitleCard/TitleInput",
        "event": "OnChange",
        "value": "Fictional edited draft"
      },
      {
        "op": "event",
        "path": "TableLab/DraftForm/AmountCard/AmountInput",
        "event": "OnChange",
        "value": "42"
      },
      {
        "op": "assert",
        "formula": "DraftForm.Unsaved && DraftForm.Updates.Amount=42",
        "expect": true
      },
      {
        "op": "failure",
        "list": "Drafts",
        "mode": "write"
      },
      {
        "op": "event",
        "path": "TableLab/Save",
        "event": "OnSelect"
      },
      {
        "op": "assert",
        "formula": "DraftForm.Unsaved && status=T(\"Save failed\",\"\u00c9chec\")",
        "expect": true
      },
      {
        "op": "assert",
        "formula": "DraftTable.Selected.Amount=50",
        "expect": true
      },
      {
        "op": "failure",
        "list": "Drafts",
        "mode": null
      },
      {
        "op": "event",
        "path": "TableLab/Save",
        "event": "OnSelect"
      },
      {
        "op": "assert",
        "formula": "DraftTable.Selected.Title=\"Fictional edited draft\" && DraftTable.Selected.Amount=42",
        "expect": true
      },
      {
        "op": "assert",
        "formula": "DraftForm.LastSubmit.ID=5 && !DraftForm.Unsaved",
        "expect": true
      },
      {
        "op": "event",
        "path": "TableLab/DraftForm/TitleCard/TitleInput",
        "event": "OnChange",
        "value": ""
      },
      {
        "op": "event",
        "path": "TableLab/Save",
        "event": "OnSelect"
      },
      {
        "op": "assert",
        "formula": "!DraftForm.Valid && Len(TitleCard.Error)>0",
        "expect": true
      },
      {
        "op": "assert",
        "formula": "DraftTable.Selected.Title=\"Fictional edited draft\"",
        "expect": true
      },
      {
        "op": "event",
        "path": "TableLab/Reset",
        "event": "OnSelect"
      },
      {
        "op": "assert",
        "formula": "DraftForm.Valid && !DraftForm.Unsaved",
        "expect": true
      },
      {
        "op": "event",
        "path": "TableLab/LeftFilter/Switch",
        "event": "OnChange",
        "value": true
      },
      {
        "op": "assert",
        "formula": "DraftTable.Selected.ID=1 && CountRows(DraftTable.Items)=4",
        "expect": true
      },
      {
        "op": "assert",
        "formula": "OtherTable.Selected.ID=102",
        "expect": true
      },
      {
        "op": "event",
        "path": "TableLab/RightShow/Switch",
        "event": "OnChange",
        "value": false
      },
      {
        "op": "assert",
        "formula": "!AmountColumn.Visible && CountRows(events)=2",
        "expect": true
      },
      {
        "op": "event",
        "path": "TableLab/Narrow",
        "event": "OnSelect"
      },
      {
        "op": "assert",
        "formula": "DraftTable.Width=540",
        "expect": true
      },
