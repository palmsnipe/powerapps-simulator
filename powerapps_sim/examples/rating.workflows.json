{
  "rating.workflow.json": {
    "format_version": 1,
    "name": "Rating steps, component isolation and save recovery",
    "records": {
      "Feedback": [
        {
          "ID": 1,
          "Title": "Fictional feedback 1",
          "Score": 1
        },
        {
          "ID": 2,
          "Title": "Fictional feedback 2",
          "Score": 2
        },
        {
          "ID": 3,
          "Title": "Fictional feedback 3",
          "Score": 3
        }
      ]
    },
    "steps": [
      {
        "op": "assert",
        "formula": "LeftRating.Current=2.5 && RightRating.Current=2.5",
        "expect": true
      },
      {
        "op": "event",
        "path": "RatingLab/LeftRating/Score",
        "event": "OnChange",
        "value": 4.5
      },
      {
        "op": "assert",
        "formula": "LeftRating.Current=4.5 && CountRows(LeftRating.History)=1 && RightRating.Current=2.5",
        "expect": true
      },
      {
        "op": "event",
        "path": "RatingLab/LeftRating/Score",
        "event": "OnChange",
        "value": 4.5
      },
      {
        "op": "assert",
        "formula": "CountRows(events)=1",
        "expect": true
      },
      {
        "op": "event",
        "path": "RatingLab/RightRating/Score",
        "event": "OnChange",
        "value": 3.5
      },
      {
        "op": "assert",
        "formula": "RightRating.Current=3.5 && CountRows(RightRating.History)=1",
        "expect": true
      },
      {
        "op": "event",
        "path": "RatingLab/ResetLeftRating",
        "event": "OnSelect"
      },
      {
        "op": "assert",
        "formula": "LeftRating.Current=2.5 && CountRows(LeftRating.History)=0 && RightRating.Current=3.5",
        "expect": true
      },
      {
        "op": "event",
        "target": "Index(FeedbackRows.AllItems,2).RowScore",
        "event": "OnChange",
        "value": 4
      },
      {
        "op": "assert",
        "formula": "LookUp(Feedback,ID=2).Score=4 && First(Feedback).Score=1",
        "expect": true
      },
      {
        "op": "event",
        "path": "RatingLab/FeedbackForm/ScoreCard/FormScore",
        "event": "OnChange",
        "value": 4.5
      },
      {
        "op": "assert",
        "formula": "FeedbackForm.Unsaved && FeedbackForm.Updates.Score=4.5",
        "expect": true
      },
      {
        "op": "failure",
        "list": "Feedback",
        "mode": "write"
      },
      {
        "op": "event",
        "path": "RatingLab/SaveScore",
        "event": "OnSelect"
      },
      {
        "op": "assert",
        "formula": "FeedbackForm.Unsaved && First(Feedback).Score=1 && status=T(\"Save failed\",\"\u00c9chec\")",
        "expect": true
      },
      {
        "op": "failure",
        "list": "Feedback",
        "mode": null
      },
      {
        "op": "event",
        "path": "RatingLab/SaveScore",
        "event": "OnSelect"
      },
      {
        "op": "assert",
        "formula": "!FeedbackForm.Unsaved && FeedbackForm.LastSubmit.Score=4.5 && First(Feedback).Score=4.5",
        "expect": true
      },
      {
        "op": "event",
        "path": "RatingLab/ChangeDefaults",
        "event": "OnSelect"
      },
      {
        "op": "assert",
        "formula": "LeftRating.Current=1 && RightRating.Current=1 && CountRows(events)=3",
        "expect": true
      },
      {
        "op": "diagnostics",
        "expect": 0
      }
    ]
  }
}
